<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GreenFlix"
        tools:targetApi="31">

        <!-- Splash Activity as Launcher -->
        <activity
            android:name="com.reiner.greenflix.view.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.GreenFlix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name="com.reiner.greenflix.view.LoginActivity"
            android:exported="false" />

        <!-- Register Activity -->
        <activity
            android:name="com.reiner.greenflix.view.RegisterActivity"
            android:exported="false" />

        <!-- Main Activity -->
        <activity
            android:name="com.reiner.greenflix.view.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <!-- Detail Activity -->
        <activity
            android:name="com.reiner.greenflix.view.DetailActivity"
            android:exported="false" />

        <!-- Update Activity -->
        <activity
            android:name="com.reiner.greenflix.view.UpdateActivity"
            android:exported="false" />

    </application>

</manifest>