<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GreenFlix" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaryGreen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.GreenFlix" parent="Base.Theme.GreenFlix" />

    <style name="GreenFlixSearchView" parent="Widget.AppCompat.SearchView">
        <!-- Text color for the search query -->
        <item name="android:editTextColor">@color/white</item>
        <!-- Hint text color -->
        <item name="android:textColorHint">@color/textGrey</item>
    </style>
</resources>